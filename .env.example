# Optional server-side cloud mirror. Never use VITE_ for a secret.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional dedicated Obsidian vault export directory.
OBSIDIAN_VAULT_PATH=
# API port. Vite proxy defaults to 3001.
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
