# Optional server-side cloud mirror. Never use VITE_ for a secret.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional dedicated Obsidian vault export directory.
OBSIDIAN_VAULT_PATH=
# API port. Vite proxy defaults to 3001.
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Optional shared token for the local API. Leave empty to keep the previous
# behaviour (no auth, server bound to 127.0.0.1). Set it whenever the server is
# reachable from other devices on your network -- the PIN screen is only a screen
# lock and never protected these endpoints. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Then paste the same value into Laporan project > Token API perangkat ini.
DARU_API_TOKEN=
